# Proveedor del LLM: mock | gemini | ollama | remoto (RNF-22)
VITE_LLM_PROVIDER=mock
# Gemini (solo si VITE_LLM_PROVIDER=gemini). Clave gratis en https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Modelos en orden de preferencia; si uno está saturado se usa el siguiente
VITE_GEMINI_MODELOS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest
# Ollama local (solo si VITE_LLM_PROVIDER=ollama)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODELO=llama3.2
# Proxy propio hacia una API remota (Claude, Gemini). La clave vive en el proxy, nunca en el navegador.
VITE_REMOTO_URL=
# Salas de clima compartido (RF-26). Vacío = modo demo entre pestañas del mismo navegador.
# Con `npm run salas` corriendo: ws://localhost:8787 (o ws://<IP de la laptop>:8787 para probar con el celular)
VITE_SALAS_URL=
